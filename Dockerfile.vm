FROM docker:28-dind

RUN apk add --no-cache openssh-server openssh-client bash curl

RUN mkdir -p /root/.ssh /run/sshd \
    && chmod 700 /root/.ssh \
    && ssh-keygen -A \
    && printf '\nPermitRootLogin prohibit-password\nPubkeyAuthentication yes\nPasswordAuthentication no\nAllowTcpForwarding yes\n' >> /etc/ssh/sshd_config

EXPOSE 22 3000 3001 8080 9090

CMD ["sh", "-c", "dockerd-entrypoint.sh & /usr/sbin/sshd -D"]
